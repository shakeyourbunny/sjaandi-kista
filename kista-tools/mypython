set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# The venv interpreter directly: sourcing activate breaks when the
# project directory moves, and this shim did exactly that once.
exec "$PROJECT_DIR/.venv/bin/python" "$@"
